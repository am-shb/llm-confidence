# Template for .env -- copy to .env and fill in. .env is gitignored; this file
# is committed, so it must never contain a real credential.
#
#   cp .env.example .env
#
# All six LLM arms (J, F1-V, F2-V, Q-V, Q-L) route through OpenRouter, so this
# is the only credential the study needs. Arms A, P and P* are local and need
# none.

# Required. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Sent as OpenRouter's attribution headers; they affect nothing about
# the results and can stay empty.
OPENROUTER_APP_TITLE=jev-calibration-study
OPENROUTER_HTTP_REFERER=

# Optional fallback path. Only used if phase 5 finds that the pinned Parasail
# endpoint does not return answer-token logprobs in practice, in which case the
# Qwen arms move to a local vLLM server (see design doc section 2.1). Leave
# empty to route the Qwen arms through OpenRouter as designed.
QWEN_LOCAL_BASE_URL=
